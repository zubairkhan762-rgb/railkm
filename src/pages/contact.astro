---
import Layout from '../layouts/Layout.astro';

const supportEmail = 'support@railkm.com';
const feedbackEmail = 'feedback@railkm.com';

const title = 'Contact RailKM — Support & Feedback';
const description =
	'Contact the RailKM team for support, bug reports, data corrections or partnership enquiries. Reach us at support@railkm.com or send a message from the contact form.';
---

<Layout title={title} description={description} backHref="/" backLabel="Back to Route Mapper">
	<div class="relative mx-auto w-full max-w-4xl px-4 pt-12 pb-24 sm:px-6 sm:pt-16">
		<nav aria-label="Breadcrumb" class="data-mono text-eyebrow uppercase text-muted">
			<ol class="flex flex-wrap items-center gap-2">
				<li><a class="focus-ring rounded-sm transition-colors hover:text-foreground" href="/">Home</a></li>
				<li aria-hidden="true">/</li>
				<li class="text-foreground">Contact</li>
			</ol>
		</nav>

		<p class="mt-8 data-mono text-eyebrow font-medium uppercase text-muted">Support</p>
		<h1 class="mt-5 text-balance text-heading-lg font-semibold text-foreground">Contact Us</h1>
		<p class="mt-4 max-w-2xl text-body-lg text-muted">
			Found a wrong distance, a missing station or a bug? Want to suggest a feature or partner with
			us? Send a message and we'll get back to you.
		</p>

		<div class="mt-10 grid gap-6 lg:grid-cols-12">
			<section
				aria-labelledby="contact-form-heading"
				class="rounded-md border border-line bg-surface p-5 sm:p-6 lg:col-span-7"
			>
				<h2 id="contact-form-heading" class="text-heading-md font-semibold text-foreground">
					Send us a message
				</h2>
				<p class="mt-1 text-body-sm text-muted">
					This form opens a pre-filled draft in your own email app — nothing is sent to a server.
				</p>

				<form id="contact-form" class="mt-5 flex flex-col gap-4" novalidate>
					<label class="flex flex-col gap-1.5">
						<span class="data-mono text-eyebrow uppercase text-muted">Your name</span>
						<input
							id="cf-name"
							name="name"
							type="text"
							autocomplete="name"
							required
							placeholder="e.g. Ananya Sharma"
							class="focus-ring min-h-[44px] w-full rounded-sm border border-line bg-background px-4 py-2.5 text-body-md text-foreground placeholder:text-muted/70"
						/>
					</label>

					<label class="flex flex-col gap-1.5">
						<span class="data-mono text-eyebrow uppercase text-muted">Email address</span>
						<input
							id="cf-email"
							name="email"
							type="email"
							autocomplete="email"
							required
							placeholder="you@example.com"
							class="focus-ring min-h-[44px] w-full rounded-sm border border-line bg-background px-4 py-2.5 text-body-md text-foreground placeholder:text-muted/70"
						/>
					</label>

					<label class="flex flex-col gap-1.5">
						<span class="data-mono text-eyebrow uppercase text-muted">Topic</span>
						<select
							id="cf-topic"
							name="topic"
							class="focus-ring min-h-[44px] w-full rounded-sm border border-line bg-background px-4 py-2.5 text-body-md text-foreground"
						>
							<option>General enquiry</option>
							<option>Bug report</option>
							<option>Distance / data correction</option>
							<option>Feature request</option>
							<option>Partnership</option>
							<option>Other</option>
						</select>
					</label>

					<label class="flex flex-col gap-1.5">
						<span class="data-mono text-eyebrow uppercase text-muted">Message</span>
						<textarea
							id="cf-message"
							name="message"
							rows="6"
							required
							placeholder="Include the station codes and route you were checking, if relevant."
							class="focus-ring w-full rounded-sm border border-line bg-background px-4 py-2.5 text-body-md text-foreground placeholder:text-muted/70"></textarea>
					</label>

					<div class="flex flex-wrap items-center gap-3">
						<button
							type="submit"
							class="focus-ring inline-flex min-h-[44px] items-center gap-2 rounded-sm border border-foreground bg-foreground px-4 py-2.5 text-label-sm font-medium text-background transition-opacity hover:opacity-90"
						>
							Open email draft <span aria-hidden="true">→</span>
						</button>
						<span id="cf-status" class="text-body-sm text-muted" role="status" aria-live="polite"></span>
					</div>
				</form>
			</section>

			<aside class="flex flex-col gap-6 lg:col-span-5">
				<section class="rounded-md border border-line bg-surface p-5 sm:p-6">
					<h2 class="text-heading-md font-semibold text-foreground">Direct email</h2>
					<dl class="mt-4 flex flex-col gap-3 text-body-md">
						<div>
							<dt class="data-mono text-eyebrow uppercase text-muted">Support</dt>
							<dd class="mt-1">
								<a
									class="focus-ring rounded-sm data-mono text-foreground transition-colors hover:text-link"
									href={`mailto:${supportEmail}`}>{supportEmail}</a>
							</dd>
						</div>
						<div>
							<dt class="data-mono text-eyebrow uppercase text-muted">Feedback</dt>
							<dd class="mt-1">
								<a
									class="focus-ring rounded-sm data-mono text-foreground transition-colors hover:text-link"
									href={`mailto:${feedbackEmail}`}>{feedbackEmail}</a>
							</dd>
						</div>
					</dl>
				</section>

				<section class="rounded-md border border-line bg-surface p-5 sm:p-6">
					<h2 class="text-heading-md font-semibold text-foreground">Before you write</h2>
					<ul class="mt-3 flex flex-col gap-2 text-body-sm text-muted">
						<li>Distance queries: include the origin and destination codes (e.g. NDLS, BPL).</li>
						<li>Data corrections: mention the affected section and the figure you expected.</li>
						<li>Bug reports: describe what you did and what you saw.</li>
					</ul>
					<p class="mt-4 text-body-sm text-muted">
						We aim to reply within a few business days. RailKM is an independent project, so
						we cannot help with ticket bookings or live train status.
					</p>
				</section>
			</aside>
		</div>
	</div>

	<script>
		const form = document.getElementById('contact-form');
		if (form) {
			const nameEl = document.getElementById('cf-name') as HTMLInputElement | null;
			const emailEl = document.getElementById('cf-email') as HTMLInputElement | null;
			const topicEl = document.getElementById('cf-topic') as HTMLSelectElement | null;
			const messageEl = document.getElementById('cf-message') as HTMLTextAreaElement | null;
			const statusEl = document.getElementById('cf-status');

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				const name = nameEl?.value.trim() ?? '';
				const email = emailEl?.value.trim() ?? '';
				const topic = topicEl?.value || 'General enquiry';
				const message = messageEl?.value.trim() ?? '';

				if (!name || !email || !message) {
					if (statusEl) statusEl.textContent = 'Please fill in your name, email and message.';
					return;
				}

				const subject = `[RailKM] ${topic}`;
				const body = `Name: ${name}\nEmail: ${email}\nTopic: ${topic}\n\n${message}`;
				window.location.href = `mailto:support@railkm.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
				if (statusEl) statusEl.textContent = 'Opening your email app…';
			});
		}
	</script>
</Layout>

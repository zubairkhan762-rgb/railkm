---
import Layout from '../layouts/Layout.astro';
import BackToTop from '../components/BackToTop.astro';
import graph from '../data/railway-graph.json';

const stationCount = graph.metadata.totalStations.toLocaleString('en-IN');
const title = 'Indian Railway TA (Travelling Allowance) Calculator — 8 km Rule & Daily Slab | RailKM';
const description = `Free Indian Railway TA (Travelling Allowance) calculator for 7th CPC pay levels. Verify the 8 km headquarter station rule, duty duration and the 30% / 70% / 100% daily TA duration slabs across ${stationCount} indexed stations.`;

const taFaqs = [
	{
		question: 'Is TA payable if the place of duty is only 7 km from headquarters?',
		answer:
			'No. The 8 km rule is a floor, and the distance is rail track distance, not road distance. At 7 km the duty point is inside the limit, so no daily TA is admissible however long the employee is held there. At exactly 8 km the claim still fails; TA begins only when the distance is more than 8 km. Confirm the figure from the station index or the route mapper before writing the journal.',
	},
	{
		question: 'How is time away counted when the train is running late?',
		answer:
			'Time is counted from actual sign-off at headquarters to actual sign-on back at headquarters, not from the timetabled departure or arrival. If a late-running train brings the employee back four hours behind schedule, those hours count towards the slab. The movement order gives the sanctioned duty; the journal records the real times. Note both the timetabled and the actual times in the remarks column so the dealing clerk can see why the slab is higher than expected.',
	},
	{
		question: 'Can Trackmen and Technicians claim both TA and Night Duty Allowance for the same duty?',
		answer:
			'Yes, when each is separately earned. Night Duty Allowance (NDA) is for hours worked between 22:00 and 06:00 and is paid by the number of night hours. Daily TA is for duty beyond 8 km from headquarters and is paid by duration slab. A night patrol more than 8 km from headquarters can carry both, shown on separate lines of the journal. What cannot happen is drawing TA for a night block already paid as NDA under a different rule; the two are kept distinct.',
	},
	{
		question: 'What happens after 180 days of continuous halt or duty at one station?',
		answer:
			'When an employee is held continuously at one station for more than 180 days without a change of headquarters, that station is generally treated as the headquarters and daily TA to it stops from the date the limit is crossed. The section must report the position to the establishment branch before the limit is reached so the posting is regularised. TA already drawn for the period up to the crossing date is not recovered unless the halt was unauthorised.',
	},
	{
		question: 'How do I submit the monthly TA journal to the dealing clerk?',
		answer:
			'Maintain the journal daily, with the movement order number, the headquarters and duty stations, the distance, and the departure and arrival times against each entry. At month-end the section supervisor countersigns it and forwards it to the dealing clerk. The clerk checks the pay level, the slab and the distance, then passes it into HRMS/IPAS for bill processing. Submit before the cut-off fixed by the division; late journals need the controlling officer condonation.',
	},
	{
		question: 'When do the daily TA rates change after a DA revision?',
		answer:
			'The daily rates step up by 25% automatically once Dearness Allowance crosses 50%. The standard rates of Rs 500, Rs 800, Rs 900, Rs 1,000 and Rs 1,200 become Rs 625, Rs 1,000, Rs 1,125, Rs 1,250 and Rs 1,500 from the date of the DA order. No separate application is filed; the rate is applied by the bill section. If the order is retrospective, the higher rate applies from that date and the arrears are drawn in the next bill.',
	},
	{
		question: 'Is TA paid on the day of transfer or joining?',
		answer:
			'Transfer and joining are governed by transfer TA rules, which are separate from daily duty TA. Ordinary daily duty TA covers journeys on official work while the employee remains posted at the same headquarters. The day an employee is relieved for transfer, or reports for joining, is dealt with under the transfer grant, packing allowance and related provisions, not under the 30/70/100 duty slabs. Keep the two claim types on separate journals.',
	},
	{
		question: 'Can TA be claimed for departmental training at another station?',
		answer:
			'Yes, if the training station is more than 8 km from headquarters by rail and a movement order is issued. Training away from headquarters is duty, so the duration slabs apply to the hours away. Where the training is non-residential and the employee returns to headquarters daily, the part-day slab applies; where a night halt is involved, the 24-hour block at 100% applies. Training allowance, if any, is claimed separately and does not change the daily TA.',
	},
	{
		question: 'Is the 8 km test done on road distance or rail distance?',
		answer:
			'Rail distance only. The 8 km limit is measured station-to-station along the shortest rail route. Road distance, the nearest bus stop, or a phone map reading is not the basis. This is why the route mapper gives the ruling figure: it follows the actual track alignment through junctions. Note the rail distance in the journal and let the dealing clerk verify it from the station index.',
	},
	{
		question: 'What documents must accompany a TA claim?',
		answer:
			'A movement order for the journey, the monthly TA journal with times and distances, and the station-index or route-map distance where the 8 km limit is close. Where NDA or training allowance is also claimed, the sanction for that allowance is attached. The dealing clerk returns any claim that lacks a movement order reference, has mismatched times, or shows a slab the entries do not support. Keep copies until the bill is passed.',
	},
	{
		question: 'Do Loco Pilots and Guards draw daily TA for a run?',
		answer:
			'Running Staff, that is Loco Pilots, Assistant Loco Pilots and Train Managers or Guards, are paid Running Allowance, commonly called Kilometreage Allowance (KMA), under the mileage formula rather than ordinary daily duty TA. A run is compensated through KMA plus the prescribed running allowances, so daily TA is not claimed for the same trip. When a running employee is called for a non-running duty away from headquarters, such as a course, that separate duty is dealt with on its own claim.',
	},
	{
		question: 'Is TA payable for a short 3-hour call to a station 15 km away?',
		answer:
			'Yes. The distance is more than 8 km, so the claim is admissible, and 3 hours away falls in the six-hours-or-less slab, giving 30% of the daily rate. For a Level 5 employee that is 30% of Rs 500, which is Rs 150. Short duties are easy to overlook, so list every call in the journal with its movement order number, because the bill section pays only what the journal supports.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: taFaqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: { '@type': 'Answer', text: faq.answer },
	})),
};

const taRates = [
	{ level: 'Level 1-5', standard: '₹500', da: '₹625' },
	{ level: 'Level 6-8', standard: '₹800', da: '₹1,000' },
	{ level: 'Level 9-11', standard: '₹900', da: '₹1,125' },
	{ level: 'Level 12-13A', standard: '₹1,000', da: '₹1,250' },
	{ level: 'Level 14 and above', standard: '₹1,200', da: '₹1,500' },
];
---

<Layout title={title} description={description} backHref="/" backLabel="Back to Route Calculator">
	<div class="relative overflow-hidden">
		<div
			data-print="hide"
			class="pointer-events-none absolute inset-x-0 top-0 h-[320px] bg-[radial-gradient(ellipse_80%_60%_at_50%_-20%,rgba(237,237,237,0.06),transparent)]"
			aria-hidden="true"
		>
		</div>

		<div class="relative mx-auto w-full max-w-4xl px-4 pt-5 pb-6 sm:px-6 sm:pt-16 sm:pb-24 print:pt-0 print:pb-0">
			<nav data-print="hide" aria-label="Breadcrumb" class="data-mono text-eyebrow uppercase text-muted">
				<ol class="flex flex-wrap items-center gap-2">
					<li><a class="focus-ring rounded-sm transition-colors hover:text-foreground" href="/">Home</a></li>
					<li aria-hidden="true">/</li>
					<li class="text-foreground" data-i18n="navTa">TA Calculator</li>
				</ol>
			</nav>

			<p data-print="hide" class="mt-4 data-mono text-eyebrow font-medium uppercase text-muted sm:mt-8" data-i18n="taEyebrow">
				Indian Railways · Travelling Allowance
			</p>
			<h1
				data-print="hide"
				data-i18n="taTitle"
				class="mt-2 text-balance text-2xl font-semibold text-foreground sm:mt-5 sm:text-display-xl"
			>
				Indian Railway TA (Travelling Allowance) Calculator
			</h1>
			<p data-print="hide" class="mt-3 hidden max-w-2xl text-body-lg text-muted sm:mt-4 sm:block" data-i18n="taDesc">
				Work out the daily TA entitlement for a railway duty journey: pick the 7th CPC pay level and
				daily TA rate, verify the 8 km station-distance rule from your headquarters, and let the
				30% / 70% / 100% duration slabs compute the total amount.
			</p>

			<div data-print="hide" class="mt-4 grid gap-4 sm:mt-10 sm:gap-6">
				<section
					id="ta-setup"
					aria-labelledby="setup-heading"
					class="rounded-lg border border-line bg-surface p-5 sm:p-6"
				>
					<p class="data-mono text-eyebrow uppercase text-muted" data-i18n="step1Label">
						Step 1 · Employee pay level
					</p>
					<h2 id="setup-heading" class="mt-1 text-heading-md font-semibold text-foreground" data-i18n="step1Heading">
						Pay level &amp; daily TA rate
					</h2>

					<div class="mt-5 grid gap-4 sm:grid-cols-2">
						<label class="flex flex-col gap-1.5">
							<span class="data-mono text-eyebrow uppercase text-muted" data-i18n="payLevelLabel">7th CPC Pay Level</span>
							<select
								id="ta-level"
								class="focus-ring min-h-[44px] w-full rounded-sm border border-line bg-background px-4 py-2.5 text-body-md text-foreground"
							>
								<option value="1-5" data-i18n="payLevel1">Level 1 to 5 — ₹500 / ₹625</option>
								<option value="6-8" data-i18n="payLevel2">Level 6 to 8 — ₹800 / ₹1000</option>
								<option value="9-11" data-i18n="payLevel3">Level 9 to 11 — ₹900 / ₹1125</option>
								<option value="12-13a" data-i18n="payLevel4">Level 12 to 13A — ₹1000 / ₹1250</option>
								<option value="14" data-i18n="payLevel5">Level 14 and above — ₹1200 / ₹1500</option>
							</select>
						</label>

						<label class="flex flex-col gap-1.5">
							<span class="data-mono text-eyebrow uppercase text-muted" data-i18n="daRevisionLabel">DA Revision</span>
							<select
								id="ta-da"
								class="focus-ring min-h-[44px] w-full rounded-sm border border-line bg-background px-4 py-2.5 text-body-md text-foreground"
							>
								<option value="standard" data-i18n="daStandard">Standard rate (no DA revision)</option>
								<option value="da" data-i18n="daWithDa">With 50%+ DA revision</option>
							</select>
						</label>
					</div>

					<label class="mt-4 flex flex-col gap-1.5">
						<span class="data-mono text-eyebrow uppercase text-muted" data-i18n="dailyRateLabel">
							Daily 100% TA Rate (editable)
						</span>
						<span class="relative">
							<span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted" aria-hidden="true">₹</span>
							<input
								id="ta-rate"
								type="number"
								min="0"
								step="1"
								value="500"
								inputmode="numeric"
								class="data-mono focus-ring min-h-[44px] w-full rounded-sm border border-line bg-background py-2.5 pl-8 pr-4 text-body-md text-foreground"
							/>
						</span>
						<span class="text-body-sm text-muted" data-i18n="dailyRateHint">
							Preset from the selected level, then type any exact amount (₹500, ₹625, ₹800, ₹1000,
							₹1250 …) to override.
						</span>
					</label>
				</section>

				<section
					id="ta-distance"
					aria-labelledby="distance-heading"
					class="rounded-lg border border-line bg-surface p-5 sm:p-6"
				>
					<p class="data-mono text-eyebrow uppercase text-muted" data-i18n="step2Label">
						Step 2 · Station distance (8 km rule)
					</p>
					<h2 id="distance-heading" class="mt-1 text-heading-md font-semibold text-foreground" data-i18n="step2Heading">
						Headquarter &amp; duty station
					</h2>

					<div class="mt-5 grid gap-4 sm:grid-cols-2">
						<div class="flex flex-col gap-1.5">
							<label class="data-mono text-eyebrow uppercase text-muted" for="ta-hq" data-i18n="hqLabel">Headquarter Station</label>
							<div class="relative">
								<input
									id="ta-hq"
									name="ta-hq"
									type="text"
									placeholder="e.g. VGLJ or Jhansi"
									data-i18n-placeholder="hqPlaceholder"
									autocomplete="off"
									autocapitalize="off"
									autocorrect="off"
									spellcheck="false"
									role="combobox"
									aria-expanded="false"
									aria-controls="ta-hq-list"
									aria-autocomplete="list"
									class="focus-ring min-h-[44px] w-full rounded-sm border border-line bg-background px-4 py-2.5 text-body-md text-foreground placeholder:text-muted"
								/>
								<ul
									id="ta-hq-list"
									role="listbox"
									aria-label="Headquarter station suggestions"
									class="absolute left-0 right-0 z-30 mt-1 hidden max-h-72 overflow-auto rounded-md border border-line bg-surface shadow-[0_12px_32px_-12px_rgba(0,0,0,0.8)]"></ul>
							</div>
							<p class="data-mono text-eyebrow text-muted hidden" data-caption="hq"></p>
						</div>

						<div class="flex flex-col gap-1.5">
							<label class="data-mono text-eyebrow uppercase text-muted" for="ta-duty" data-i18n="dutyLabel">Duty / Tour Station</label>
							<div class="relative">
								<input
									id="ta-duty"
									name="ta-duty"
									type="text"
									placeholder="e.g. BPL or Bhopal"
									data-i18n-placeholder="dutyPlaceholder"
									autocomplete="off"
									autocapitalize="off"
									autocorrect="off"
									spellcheck="false"
									role="combobox"
									aria-expanded="false"
									aria-controls="ta-duty-list"
									aria-autocomplete="list"
									class="focus-ring min-h-[44px] w-full rounded-sm border border-line bg-background px-4 py-2.5 text-body-md text-foreground placeholder:text-muted"
								/>
								<ul
									id="ta-duty-list"
									role="listbox"
									aria-label="Duty station suggestions"
									class="absolute left-0 right-0 z-30 mt-1 hidden max-h-72 overflow-auto rounded-md border border-line bg-surface shadow-[0_12px_32px_-12px_rgba(0,0,0,0.8)]"></ul>
							</div>
							<p class="data-mono text-eyebrow text-muted hidden" data-caption="duty"></p>
						</div>
					</div>

					<div id="ta-distance-result" class="mt-4"></div>
				</section>

				<section
					id="ta-duty-time"
					aria-labelledby="duty-time-heading"
					class="rounded-lg border border-line bg-surface p-5 sm:p-6"
				>
					<p class="data-mono text-eyebrow uppercase text-muted" data-i18n="step3Label">Step 3 · Duty duration</p>
					<h2 id="duty-time-heading" class="mt-1 text-heading-md font-semibold text-foreground" data-i18n="step3Heading">
						Time away from headquarters
					</h2>

					<div class="mt-5 grid gap-4 sm:grid-cols-2">
						<label class="flex flex-col gap-1.5">
							<span class="data-mono text-eyebrow uppercase text-muted" data-i18n="departLabel">Departure from HQ (Date &amp; Time)</span>
							<input
								id="ta-depart"
								name="ta-depart"
								type="datetime-local"
								step="60"
								class="data-mono focus-ring min-h-[44px] w-full rounded-sm border border-line bg-background px-4 py-2.5 text-body-md text-foreground"
							/>
						</label>

						<label class="flex flex-col gap-1.5">
							<span class="data-mono text-eyebrow uppercase text-muted" data-i18n="arriveLabel">Arrival back at HQ (Date &amp; Time)</span>
							<input
								id="ta-arrive"
								name="ta-arrive"
								type="datetime-local"
								step="60"
								class="data-mono focus-ring min-h-[44px] w-full rounded-sm border border-line bg-background px-4 py-2.5 text-body-md text-foreground"
							/>
						</label>
					</div>

					<ul class="mt-4 flex flex-wrap gap-2">
						<li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-background px-3 py-1.5 text-body-sm">
							<span class="text-muted" data-i18n="slabUpTo6">Up to 6 h</span>
							<span class="data-mono font-semibold text-foreground">30%</span>
						</li>
						<li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-background px-3 py-1.5 text-body-sm">
							<span class="text-muted" data-i18n="slab6to12">6–12 h</span>
							<span class="data-mono font-semibold text-foreground">70%</span>
						</li>
						<li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-background px-3 py-1.5 text-body-sm">
							<span class="text-muted" data-i18n="slab12plus">12 h +</span>
							<span class="data-mono font-semibold text-foreground">100%</span>
						</li>
					</ul>
				</section>

				<div id="ta-result"></div>
			</div>

			<section
				id="ta-sheet-section"
				aria-labelledby="sheet-heading"
				class="mt-6 rounded-lg border border-line bg-surface p-5 sm:p-6 print:border-0 print:bg-transparent print:p-0"
			>
				<p class="data-mono text-eyebrow uppercase text-muted" data-i18n="step4Label">Step 4 · Monthly TA log</p>
				<h2 id="sheet-heading" class="mt-1 text-heading-md font-semibold text-foreground" data-i18n="sheetHeading">
					MONTHLY TA STATEMENT (SAVED IN BROWSER)
				</h2>
				<p class="mt-2 max-w-2xl text-body-sm text-muted" data-i18n="sheetDesc">
					Add each calculated journey to build a month-wise TA log. Entries are stored only in this
					browser — nothing is uploaded.
				</p>

				<div class="mt-4 flex flex-wrap items-center gap-2" data-print="hide">
					<button
						type="button"
						id="ta-whatsapp"
						class="focus-ring inline-flex min-h-[44px] items-center gap-2 rounded-sm border border-emerald-600/30 bg-emerald-500/10 px-4 py-2.5 text-label-sm text-emerald-700 transition-colors hover:border-emerald-600/60 hover:bg-emerald-500/20 dark:border-emerald-500/30 dark:text-emerald-400 dark:hover:border-emerald-500/60 dark:hover:bg-emerald-500/20"
					>
						<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24Zm-2.6 4.36c-.13 0-.33.05-.5.24-.17.19-.66.64-.66 1.57 0 .93.68 1.83.77 1.95.09.12 1.31 2.1 3.25 2.88 1.61.64 1.94.51 2.29.48.35-.03 1.13-.46 1.29-.91.16-.45.16-.83.11-.91-.05-.08-.17-.13-.35-.22-.18-.09-1.13-.56-1.3-.62-.18-.07-.31-.1-.44.09-.13.19-.5.63-.62.76-.11.13-.23.14-.41.05-.18-.09-.77-.28-1.46-.9-.54-.48-.9-1.07-1.01-1.26-.11-.19-.01-.29.08-.38.08-.08.18-.23.27-.34.09-.11.12-.19.18-.31.06-.12.03-.23-.01-.32-.05-.09-.43-1.05-.6-1.43-.16-.38-.32-.33-.44-.33-.11 0-.24-.02-.36-.02Z"/>						</svg>
						<span data-i18n="whatsappBtn">Share TA Summary on WhatsApp</span>
					</button>
					<button
						type="button"
						id="ta-copy"
						data-i18n="copyBtn"
						class="focus-ring inline-flex min-h-[44px] items-center gap-2 rounded-sm border border-line bg-background px-4 py-2.5 text-label-sm text-foreground transition-colors hover:border-foreground/40"
					>
						Copy Text Summary
					</button>
					<button
						type="button"
						id="ta-print"
						data-i18n="printBtn"
						class="focus-ring inline-flex min-h-[44px] items-center gap-2 rounded-sm border border-foreground bg-foreground px-4 py-2.5 text-label-sm font-medium text-background transition-opacity hover:opacity-90"
					>
						Print / Save PDF
					</button>
					<button
						type="button"
						id="ta-clear"
						data-i18n="clearBtn"
						class="focus-ring inline-flex min-h-[44px] items-center gap-2 rounded-sm border border-line bg-background px-4 py-2.5 text-label-sm text-foreground transition-colors hover:border-foreground/40"
					>
						Clear All
					</button>
				</div>

				<div
					id="ta-sheet-container"
					class="mt-5 overflow-x-auto rounded-md border border-line print:overflow-visible print:border-0"
				>
					<table class="w-full min-w-[40rem] border-collapse text-left lg:min-w-0 print:min-w-0">
						<caption class="sr-only">Saved monthly TA trips</caption>
						<thead>
							<tr class="border-b border-line bg-background/40">
								<th scope="col" class="data-mono px-2 py-2.5 text-eyebrow uppercase text-muted" data-i18n="thDate">Date</th>
								<th scope="col" class="px-2 py-2.5 text-eyebrow uppercase text-muted" data-i18n="thHqDuty">HQ → Duty</th>
								<th scope="col" class="px-2 py-2.5 text-right text-eyebrow uppercase text-muted" data-i18n="thKm">KM</th>
								<th scope="col" class="px-2 py-2.5 text-eyebrow uppercase text-muted" data-i18n="thDeparture">Departure</th>
								<th scope="col" class="px-2 py-2.5 text-eyebrow uppercase text-muted" data-i18n="thArrival">Arrival</th>
								<th scope="col" class="px-2 py-2.5 text-right text-eyebrow uppercase text-muted" data-i18n="thDuration">Duration</th>
								<th scope="col" class="px-2 py-2.5 text-right text-eyebrow uppercase text-muted" data-i18n="thSlab">Slab</th>
								<th scope="col" class="px-2 py-2.5 text-right text-eyebrow uppercase text-muted" data-i18n="thTa">TA ₹</th>
								<th scope="col" data-print="hide" class="px-2 py-2.5 text-right text-eyebrow uppercase text-muted">
									<span class="sr-only">Remove</span>
								</th>
							</tr>
						</thead>
						<tbody id="ta-sheet-body" class="text-body-sm"></tbody>
					</table>
				</div>
				<div id="ta-sheet-foot" class="mt-4"></div>
				<p id="ta-sheet-empty" class="mt-5 text-body-sm text-muted" data-i18n="sheetEmpty">
					No trips added yet. Calculate a TA amount above and press “+ Add Trip to Monthly TA Sheet”.
				</p>
			</section>

			<p data-print="hide" class="mt-6 text-body-sm text-muted sm:mt-10">
				RailKM is an independent planning tool and is not affiliated with Indian Railways. TA figures
				are indicative and use the standard duration slabs shown above — confirm entitlement with your
				railway administration.
			</p>

			<section
				id="ta-guide"
				data-print="hide"
				aria-labelledby="ta-guide-heading"
				class="mt-6 scroll-mt-20 border-t border-line pt-6 sm:mt-12 sm:pt-10"
			>
				<p class="data-mono text-eyebrow uppercase text-muted">Staff reference manual</p>
				<h2 id="ta-guide-heading" class="mt-1 text-balance text-heading-md font-semibold text-foreground">
					Travelling Allowance on duty: a working manual for railway staff
				</h2>
				<p class="mt-3 max-w-3xl text-body-md text-muted">
					Travelling Allowance (TA) on duty is paid to a railway servant who leaves headquarters (HQ) on
					official work. The entitlement turns on three figures only — the hours spent away from HQ, the
					rail distance between HQ and the place of duty, and the pay level of the employee. This manual
					is written for non-running staff: P-Way, TRD, S&amp;T, C&amp;W, Ministerial and equivalent
					cadres. It explains how daily TA is worked out, how the bill section checks it, and where TA
					stops and Night Duty Allowance or Running Allowance begins.
				</p>

				<div class="mt-6 max-w-3xl space-y-6 sm:mt-8 sm:space-y-8">
					<article>
						<h3 class="text-heading-md font-semibold text-foreground">
							1. Travelling Allowance on duty for non-running staff
						</h3>
						<div class="mt-3 space-y-3 text-body-md text-muted">
							<p>
								Daily TA is an entitlement paid by pay level, not a bill for money actually spent. The
								rules sit in the Indian Railway Establishment Code (IREC) Volume II, read with the 7th
								CPC RBE circulars issued from time to time. A non-running employee becomes eligible the
								moment a movement order is issued and duty carries the person outside HQ limits.
								Inspection runs, relief duty, breakdown attendance, escorting stores, and departmental
								training at another station all qualify.
							</p>
							<p>
								The clock starts when the employee signs off at HQ and stops when the employee signs
								back on. The controlling officer signs the movement order; the dealing clerk, not the
								claimant, applies the rate. Enter the pay level, the HQ and duty station, and the
								departure and arrival times above — the slab and the amount follow from those entries
								alone. A claim is tied to a journey on railway business, so an attendance entry without
								a movement order reference is returned to the section.
							</p>
						</div>
					</article>

					<article>
						<h3 class="text-heading-md font-semibold text-foreground">
							2. The 8 km track distance rule from headquarters
						</h3>
						<div class="mt-3 space-y-3 text-body-md text-muted">
							<p>
								The 8 km rule is a distance test, and the distance is measured along the rail route, not
								by road. HQ and the place of duty are both on the network; the gap between them is the
								chargeable track kilometres along the shortest route — the same kilometres the route
								mapper gives on the home page. A road shortcut, a stretch of town in between, or a
								phone map reading is never the basis, because bill sections work station-to-station.
							</p>
							<p>
								If the place of duty lies 8 km or less from HQ, no daily TA is admissible for that
								call, however long the employee is held there. Once the gap crosses 8 km, the full slab
								for the hours away applies. The dealing clerk confirms the figure from the station
								index or the route map, writes the ruling distance on the TA journal, and only then
								applies the slab.
							</p>
						</div>
					</article>

					<article>
						<h3 class="text-heading-md font-semibold text-foreground">
							3. How the 30%, 70% and 100% duration slabs are counted
						</h3>
						<div class="mt-3 space-y-3 text-body-md text-muted">
							<p>
								Slab counting starts at departure from HQ and ends at return to HQ. Up to 6 hours away
								earns 30% of the daily rate. Above 6 hours and up to 12 hours earns 70%. Above 12 hours
								earns 100%. The percentages are of the daily rate fixed for the pay level, so a Level 6
								employee held 5 hours earns 30% of ₹800, that is ₹240, while the same employee held 10
								hours earns 70%, that is ₹560.
							</p>
							<p>
								Multi-day duty is counted in blocks. Every completed 24 hours away from HQ carries a
								fresh 100% block, and the residue after the last full block is graded on the same
								30/70/100 scale. A duty of 28 hours is one full 24-hour block at 100% plus a 4-hour
								residue at 30% — 130% of the daily rate in all. A 30-hour duty is 100% plus a 6-hour
								residue at 30%; a 31-hour duty is 100% plus a 7-hour residue at 70%. Where a journey
								crosses midnight, the date of departure fixes the day of the claim, and the arrival
								date is entered only to work out the hours.
							</p>
						</div>
						<div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
							<div class="rounded-lg border border-line bg-surface p-5">
								<p class="data-mono text-eyebrow uppercase text-muted">Up to 6 hours</p>
								<p class="mt-3 data-mono text-2xl font-semibold tabular-nums text-foreground">30%</p>
								<p class="mt-2 text-body-sm text-muted">
									Of the daily TA rate when the duty absence from HQ is 6 hours or less.
								</p>
							</div>
							<div class="rounded-lg border border-line bg-surface p-5">
								<p class="data-mono text-eyebrow uppercase text-muted">6 to 12 hours</p>
								<p class="mt-3 data-mono text-2xl font-semibold tabular-nums text-foreground">70%</p>
								<p class="mt-2 text-body-sm text-muted">
									Of the daily TA rate when the duty absence is more than 6 but not more than 12
									hours.
								</p>
							</div>
							<div class="rounded-lg border border-line bg-surface p-5">
								<p class="data-mono text-eyebrow uppercase text-muted">Above 12 hours</p>
								<p class="mt-3 data-mono text-2xl font-semibold tabular-nums text-foreground">100%</p>
								<p class="mt-2 text-body-sm text-muted">
									Of the daily TA rate for more than 12 hours, plus 100% for every completed 24-hour
									block.
								</p>
							</div>
						</div>
					</article>

					<article>
						<h3 class="text-heading-md font-semibold text-foreground">
							4. 7th CPC pay level daily TA rates and the 50% DA revision rule
						</h3>
						<div class="mt-3 space-y-3 text-body-md text-muted">
							<p>
								The daily rate is fixed by 7th CPC pay level. Levels 1-5 draw ₹500, Levels 6-8 draw
								₹800, Levels 9-11 draw ₹900, Levels 12 and 13A draw ₹1,000, and Level 14 and above
								draw ₹1,200. These standard rates hold while Dearness Allowance stays below 50%.
							</p>
							<p>
								Once DA crosses 50%, the rates step up automatically by 25%: ₹500 becomes ₹625, ₹800
								becomes ₹1,000, ₹900 becomes ₹1,125, ₹1,000 becomes ₹1,250 and ₹1,200 becomes ₹1,500.
								The 25% revision follows the DA order itself; no separate application is filed. Use the
								rate notified for the claim month. Where a DA order carries retrospective effect, the
								higher rate applies from the date of the order and the difference is drawn in the next
								bill.
							</p>
						</div>
						<div class="mt-4 overflow-x-auto rounded-md border border-line">
							<table class="w-full min-w-[32rem] border-collapse text-left">
								<caption class="sr-only">Daily TA rates by 7th CPC pay level</caption>
								<thead>
									<tr class="border-b border-line bg-background/40">
										<th scope="col" class="data-mono px-4 py-2.5 text-eyebrow uppercase text-muted">Pay Level</th>
										<th scope="col" class="px-4 py-2.5 text-right text-eyebrow uppercase text-muted">Rate while DA below 50%</th>
										<th scope="col" class="px-4 py-2.5 text-right text-eyebrow uppercase text-muted">Rate once DA crosses 50%</th>
									</tr>
								</thead>
								<tbody class="text-body-sm">
									{
										taRates.map((rate) => (
											<tr class="border-b border-line/60 last:border-b-0">
												<th scope="row" class="px-4 py-2.5 text-left font-medium text-foreground">{rate.level}</th>
												<td class="data-mono px-4 py-2.5 text-right tabular-nums text-foreground">{rate.standard}</td>
												<td class="data-mono px-4 py-2.5 text-right tabular-nums text-foreground">{rate.da}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</article>

					<article>
						<h3 class="text-heading-md font-semibold text-foreground">
							5. Three real-world duty calculation examples
						</h3>
						<div class="mt-3 space-y-3 text-body-md text-muted">
							<p>
								<span class="font-medium text-foreground">Case 1 — Same-day S&amp;T / TRD maintenance
								call.</span> A Technician (Level 6) is called to a point on the section, signs off at HQ at
								09:30 and signs back at 14:45. Time away is 5 hours 15 minutes, which is 6 hours or less,
								so the slab is 30% of ₹800, that is ₹240. The duty point is 11 km away, above the 8 km
								limit, so the distance condition is met and the claim stands.
							</p>
							<p>
								<span class="font-medium text-foreground">Case 2 — Outstation day duty, VGLJ to
								BPL.</span> A Ministerial staff member (Level 7) travels from Virangana Lakshmibai Jhansi
								(VGLJ) to Bhopal Jn (BPL), signs off at 06:50 and returns at 16:30. Time away is 9 hours
								40 minutes, above 6 and not above 12, so the slab is 70% of ₹800, that is ₹560. Track
								distance is far above 8 km, so the distance condition is met.
							</p>
							<p>
								<span class="font-medium text-foreground">Case 3 — Overnight relief / breakdown
								duty.</span> A C&amp;W fitter (Level 5) is sent for breakdown relief and is away from HQ for
								28 hours. One completed 24-hour block is paid at 100%, and the remaining 4 hours attract
								30%, giving 130% of ₹500, that is ₹650. Claim the block and the residue on one journal
								line, showing the departure and return date-times.
							</p>
						</div>
					</article>

					<article>
						<h3 class="text-heading-md font-semibold text-foreground">
							6. Daily TA, Night Duty Allowance and Running Allowance
						</h3>
						<div class="mt-3 space-y-3 text-body-md text-muted">
							<p>
								Three payments are routinely mixed up at the counter. Daily TA is for being away from HQ
								on duty beyond 8 km and is paid by slab. Night Duty Allowance (NDA) is paid for duty
								performed between 22:00 and 06:00 and depends on the number of night hours, not on
								distance from HQ; it is claimed on its own line and does not replace TA. Running
								Allowance, commonly called Kilometreage Allowance (KMA), applies to Running Staff — Loco
								Pilots, Assistant Loco Pilots, and Train Managers or Guards — and is paid per kilometre
								run under the mileage formula.
							</p>
							<p>
								A Loco Pilot does not draw daily TA and KMA for the same trip. A Trackman on night
								patrol may draw NDA, and where the 8 km test is met, daily TA as well, each under its
								own rule. Keep the three heads separate on the journal so the dealing clerk can pass
								each without a query.
							</p>
						</div>
					</article>

					<article>
						<h3 class="text-heading-md font-semibold text-foreground">
							Filing the monthly TA journal
						</h3>
						<div class="mt-3 space-y-3 text-body-md text-muted">
							<p>
								Each employee keeps a monthly TA journal. At month-end the entries are tallied against
								movement orders, the 8 km distance is noted, and the journal moves through the section
								supervisor to the dealing clerk. The clerk checks the pay level, the slab applied and
								the distance before the claim enters HRMS/IPAS for bill processing. Claims filed beyond
								the time limit fixed by the administration need the controlling officer's condonation.
								Keep the movement order number against every entry; a slab claim without a movement
								order reference is returned.
							</p>
						</div>
					</article>
				</div>

				<h3 class="mt-8 text-heading-md font-semibold text-foreground sm:mt-12">
					12 practical questions from the section and the bill counter
				</h3>
				<div class="mt-4 space-y-3 sm:mt-6">
					{
						taFaqs.map((faq) => (
							<details class="group rounded-md border border-line bg-surface transition-colors hover:border-foreground/40">
								<summary class="focus-ring flex cursor-pointer list-none items-center justify-between gap-4 p-4 text-body-md font-medium text-foreground sm:p-5 [&::-webkit-details-marker]:hidden">
									<span>{faq.question}</span>
									<svg
										class="h-4 w-4 shrink-0 text-muted transition-transform group-open:rotate-180"
										viewBox="0 0 12 12"
										fill="none"
										aria-hidden="true"
									>
										<path
											d="M3 4.5L6 7.5l3-3"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
											stroke-linejoin="round"></path>
									</svg>
								</summary>
								<div class="border-t border-line px-4 py-3 text-body-sm text-muted sm:px-5 sm:py-4">{faq.answer}</div>
							</details>
						))
					}
				</div>
			</section>
		</div>
	</div>

	<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

	<script>
		import { searchStations, resolveStation, shortestPath, stationInfo } from '../utils/routeEngine.js';
		import { t } from '../utils/i18n.js';

		const LEVEL_PRESETS = {
			'1-5': { standard: 500, da: 625 },
			'6-8': { standard: 800, da: 1000 },
			'9-11': { standard: 900, da: 1125 },
			'12-13a': { standard: 1000, da: 1250 },
			'14': { standard: 1200, da: 1500 },
		};

		const levelSelect = document.getElementById('ta-level');
		const daSelect = document.getElementById('ta-da');
		const rateInput = document.getElementById('ta-rate');
		const departInput = document.getElementById('ta-depart');
		const arriveInput = document.getElementById('ta-arrive');
		const distanceResultEl = document.getElementById('ta-distance-result');
		const resultEl = document.getElementById('ta-result');

		let graph = null;
		let distanceKm = null;

		function esc(value) {
			return String(value).replace(/[&<>"']/g, (ch) => {
				return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
			});
		}

		/* --------------------------------------------------- Station autocomplete */

		function setupStationField(input, list, caption) {
			const idPrefix = input.id;
			let results = [];
			let active = -1;
			let selected = { code: '', query: '' };

			function updateCaption() {
				if (!caption) return;
				if (!selected.code) {
					caption.textContent = '';
					caption.classList.add('hidden');
					return;
				}
				const info = graph ? stationInfo(graph, selected.code) : null;
				caption.textContent = info ? `${selected.code} · ${info.name}` : selected.code;
				caption.classList.remove('hidden');
			}

			function close() {
				list.classList.add('hidden');
				input.setAttribute('aria-expanded', 'false');
				input.removeAttribute('aria-activedescendant');
			}

			function setActive(index) {
				if (index < 0 || index >= results.length) return;
				active = index;
				list.querySelectorAll('[data-i]').forEach((option) => {
					const on = Number(option.dataset.i) === index;
					option.setAttribute('aria-selected', String(on));
					option.classList.toggle('bg-foreground/10', on);
				});
				input.setAttribute('aria-activedescendant', `${idPrefix}-opt-${index}`);
				const activeEl = document.getElementById(`${idPrefix}-opt-${index}`);
				if (activeEl) activeEl.scrollIntoView({ block: 'nearest' });
			}

			function choose(index) {
				const result = results[index];
				if (!result) return;
				selected = { code: result.code, query: result.code };
				input.value = result.code;
				updateCaption();
				close();
				computeDistance();
			}

			function place(query) {
				if (!graph) return;
				const trimmed = query.trim();
				if (!trimmed) {
					close();
					return;
				}
				results = searchStations(graph, trimmed, 8);
				active = results.length ? 0 : -1;

				if (!results.length) {
					list.innerHTML = `<li class="px-4 py-3 text-body-sm text-muted" role="presentation">${t('taNoMatch', { query: esc(trimmed) })}</li>`;
				} else {
					list.innerHTML = results
						.map((result, index) => {
							const junctionTag = result.isJunction
								? `<span class="data-mono shrink-0 rounded-sm border border-line px-1 py-0.5 text-[10px] uppercase text-muted">Jn</span>`
								: '';
							const aliasTag = result.matchedAlias
								? `<span class="data-mono shrink-0 rounded-sm border border-line px-1 py-0.5 text-[10px] uppercase text-muted">aka ${esc(result.matchedAlias)}</span>`
								: '';
							const zoneBit = [result.zone, result.state].filter(Boolean).join(' · ');
							return `<li
								id="${idPrefix}-opt-${index}"
								role="option"
								data-i="${index}"
								aria-selected="${index === active}"
								class="flex min-h-[44px] cursor-pointer items-center gap-2 px-4 py-2.5 ${index === active ? 'bg-foreground/10' : ''}"
							>
								<span translate="no" class="data-mono shrink-0 rounded-sm border border-line bg-background px-1.5 py-0.5 text-eyebrow font-semibold text-foreground">${esc(result.code)}</span>
								<span class="min-w-0 flex-1 truncate text-body-md text-foreground">${esc(result.name)}</span>
								${aliasTag}
								${zoneBit ? `<span class="data-mono hidden shrink-0 text-eyebrow text-muted sm:inline">${esc(zoneBit)}</span>` : ''}
								${junctionTag}
							</li>`;
						})
						.join('');
					list.querySelectorAll('[data-i]').forEach((option) => {
						const index = Number(option.dataset.i);
						option.addEventListener('mousedown', (event) => event.preventDefault());
						option.addEventListener('mouseenter', () => setActive(index));
						option.addEventListener('click', () => choose(index));
					});
				}

				list.classList.remove('hidden');
				input.setAttribute('aria-expanded', 'true');
				if (active >= 0) setActive(active);
			}

			input.addEventListener('focus', () => {
				if (input.value.trim()) place(input.value);
			});
			input.addEventListener('input', () => {
				selected = { code: '', query: input.value };
				updateCaption();
				computeDistance();
				place(input.value);
			});
			input.addEventListener('keydown', (event) => {
				const open = !list.classList.contains('hidden');
				if (event.key === 'ArrowDown') {
					event.preventDefault();
					if (!open) place(input.value);
					else setActive(Math.min(active + 1, results.length - 1));
				} else if (event.key === 'ArrowUp') {
					if (!open) return;
					event.preventDefault();
					setActive(Math.max(active - 1, 0));
				} else if (event.key === 'Enter') {
					if (open && active >= 0) {
						event.preventDefault();
						choose(active);
					} else if (open && results.length) {
						event.preventDefault();
						choose(0);
					}
				} else if (event.key === 'Escape') {
					close();
				}
			});
			input.addEventListener('blur', () => {
				window.setTimeout(() => {
					close();
					if (!selected.code && input.value.trim() && graph) {
						const resolved = resolveStation(graph, input.value);
						if (resolved) {
							selected = { code: resolved.code, query: resolved.code };
							input.value = resolved.code;
							updateCaption();
							computeDistance();
						}
					}
				}, 150);
			});

			return {
				get code() {
					return selected.code;
				},
			};
		}

		const hqField = setupStationField(
			document.getElementById('ta-hq'),
			document.getElementById('ta-hq-list'),
			document.querySelector('[data-caption="hq"]')
		);
		const dutyField = setupStationField(
			document.getElementById('ta-duty'),
			document.getElementById('ta-duty-list'),
			document.querySelector('[data-caption="duty"]')
		);

		/* ------------------------------------------------ Distance (8 km rule) */

		function computeDistance() {
			if (!distanceResultEl) return;
			const hq = hqField.code;
			const duty = dutyField.code;

			if (!graph || !hq || !duty) {
				distanceKm = null;
				distanceResultEl.innerHTML = `<p class="text-body-sm text-muted">${t('distSelectBoth')}</p>`;
				render();
				return;
			}

			const result = shortestPath(graph, hq, duty);
			if (!result) {
				distanceKm = null;
				distanceResultEl.innerHTML = `<div class="rounded-md border border-error/40 bg-error/5 p-4" role="alert">
					<p class="data-mono text-eyebrow uppercase text-error">${t('distNoRouteTitle')}</p>
					<p class="mt-1 text-body-sm text-muted">${t('distNoRouteBody', { from: esc(hq), to: esc(duty) })}</p>
				</div>`;
				render();
				return;
			}

			distanceKm = result.distanceKm;
			const eligible = distanceKm > 8;
			const tone = eligible
				? {
						wrap: 'border-emerald-600/30 bg-emerald-500/10 text-emerald-700 dark:border-emerald-500/30 dark:text-emerald-400',
						dot: 'bg-emerald-600 dark:bg-emerald-400',
					}
				: {
						wrap: 'border-amber-600/30 bg-amber-500/10 text-amber-700 dark:border-amber-500/30 dark:text-amber-400',
						dot: 'bg-amber-600 dark:bg-amber-400',
					};
			const label = eligible
				? t('distEligible', { km: distanceKm.toLocaleString('en-IN') })
				: t('distNotEligible');

			distanceResultEl.innerHTML = `<div class="flex flex-col gap-3 rounded-md border border-line bg-background p-4">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<p class="data-mono text-eyebrow uppercase text-muted">${t('distShortest')}</p>
					<p class="data-mono text-body-md font-semibold text-foreground">${distanceKm.toLocaleString('en-IN')} km</p>
				</div>
				<span class="inline-flex max-w-full items-center gap-1.5 rounded-full border px-2.5 py-1 ${tone.wrap}">
					<span class="h-1.5 w-1.5 shrink-0 rounded-full ${tone.dot}" aria-hidden="true"></span>
					<span class="data-mono min-w-0 text-eyebrow leading-tight">${label}</span>
				</span>
				<p class="text-body-sm text-muted">${t('distRouteNote', { from: esc(hq), to: esc(duty) })}</p>
			</div>`;
			render();
		}

		/* -------------------------------------------- Duty duration & TA slabs */

		function dutyHours() {
			if (!departInput || !arriveInput) return null;
			if (!departInput.value || !arriveInput.value) return null;
			const depart = new Date(departInput.value);
			const arrive = new Date(arriveInput.value);
			if (Number.isNaN(depart.getTime()) || Number.isNaN(arrive.getTime())) return null;
			const ms = arrive.getTime() - depart.getTime();
			if (ms <= 0) return { error: t('errArrivalAfter') };
			return { hours: ms / 3600000 };
		}

		function slabBreakdown(hours) {
			const blocks = [];
			let remaining = hours;
			while (remaining >= 24) {
				blocks.push(100);
				remaining -= 24;
			}
			if (remaining > 0.0001) {
				blocks.push(remaining <= 6 ? 30 : remaining <= 12 ? 70 : 100);
			}
			if (!blocks.length) blocks.push(30);
			return blocks;
		}

		function durationText(hours) {
			const totalMinutes = Math.round(hours * 60);
			const days = Math.floor(totalMinutes / 1440);
			const rest = totalMinutes % 1440;
			const hh = Math.floor(rest / 60);
			const mm = rest % 60;
			const parts = [];
			if (days) parts.push(`${days} ${days > 1 ? t('unitDays') : t('unitDay')}`);
			parts.push(`${hh} h`);
			parts.push(`${mm} m`);
			return parts.join(' ');
		}

		function idleCard() {
			return `<section aria-label="TA result placeholder" class="rounded-md border border-line bg-surface p-6">
				<h2 class="text-heading-md font-semibold text-foreground">${t('resIdleTitle')}</h2>
				<p class="mt-2 max-w-2xl text-body-md text-muted">${t('resIdleText')}</p>
			</section>`;
		}

		function render() {
			if (!resultEl) return;
			const rate = Number(rateInput && rateInput.value) || 0;
			const time = dutyHours();

			if (!time) {
				resultEl.innerHTML = idleCard();
				return;
			}
			if (time.error) {
				resultEl.innerHTML = `<div class="rounded-md border border-error/40 bg-error/5 p-5" role="alert">
					<p class="data-mono text-eyebrow uppercase text-error">${t('errInvalidTime')}</p>
					<p class="mt-2 text-body-sm text-muted">${esc(time.error)}</p>
				</div>`;
				return;
			}

			const hours = time.hours;
			const blocks = slabBreakdown(hours);
			const totalPct = blocks.reduce((sum, value) => sum + value, 0);
			const amount = Math.round((rate * totalPct) / 100);
			const slabLabel = blocks.map((value) => `${value}%`).join(' + ');
			const distanceOk = typeof distanceKm === 'number';

			let distanceNote;
			if (!distanceOk) {
				distanceNote = `<p class="mt-3 text-body-sm text-muted">${t('distNotAdded')}</p>`;
			} else if (distanceKm > 8) {
				distanceNote = `<p class="mt-3 text-body-sm text-emerald-700 dark:text-emerald-400">${t('distOkNote', { km: distanceKm.toLocaleString('en-IN') })}</p>`;
			} else {
				distanceNote = `<p class="mt-3 text-body-sm text-warning">${t('distFailNote', { km: distanceKm.toLocaleString('en-IN') })}</p>`;
			}

			resultEl.innerHTML = `<section aria-label="${t('resHeading')}" class="rounded-md border border-emerald-600/30 bg-emerald-500/10 p-5 dark:border-emerald-500/30">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<h2 class="data-mono text-eyebrow uppercase text-emerald-700 dark:text-emerald-400">${t('resHeading')}</h2>
					<span class="data-mono text-eyebrow text-muted">${t('resRatePerDay', { amount: rate.toLocaleString('en-IN') })}</span>
				</div>
				<dl class="mt-4 grid grid-cols-1 gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-3">
					<div class="bg-surface p-4">
						<dt class="data-mono text-eyebrow uppercase text-muted">${t('resTotalHours')}</dt>
						<dd class="mt-2 data-mono text-xl font-semibold tabular-nums text-foreground">${hours.toFixed(1)}<span class="ml-1 text-label-sm font-normal text-muted">h</span></dd>
						<dd class="mt-1 text-body-sm text-muted">${esc(durationText(hours))}</dd>
					</div>
					<div class="bg-surface p-4">
						<dt class="data-mono text-eyebrow uppercase text-muted">${t('resApplicableSlab')}</dt>
						<dd class="mt-2 data-mono text-xl font-semibold tabular-nums text-foreground">${slabLabel}</dd>
						<dd class="mt-1 text-body-sm text-muted">${blocks.length > 1 ? t('resBlocks', { n: blocks.length }) : t('resSingleBlock')}</dd>
					</div>
					<div class="bg-surface p-4">
						<dt class="data-mono text-eyebrow uppercase text-muted">${t('resTotalAmount')}</dt>
						<dd class="mt-2 data-mono text-xl font-semibold tabular-nums text-foreground">₹${amount.toLocaleString('en-IN')}</dd>
						<dd class="mt-1 text-body-sm text-muted">${t('resOfRate', { pct: totalPct, rate: rate.toLocaleString('en-IN') })}</dd>
					</div>
				</dl>
				${distanceNote}
				<p class="mt-3 text-body-sm text-muted">${t('resDisclaimer')}</p>
				<div class="mt-4 flex flex-wrap items-center gap-3">
					<button
						type="button"
						data-add-trip
						class="focus-ring inline-flex min-h-[44px] items-center gap-2 rounded-sm border border-foreground bg-foreground px-4 py-2.5 text-label-sm font-medium text-background transition-opacity hover:opacity-90"
					>
						${t('addTripBtn')}
					</button>
				</div>
			</section>`;
		}

		/* ------------------------------------------- Monthly TA sheet (Part 2B) */

		const SHEET_KEY = 'railkm_ta_sheet_v1';
		const sheetBodyEl = document.getElementById('ta-sheet-body');
		const sheetFootEl = document.getElementById('ta-sheet-foot');
		const sheetEmptyEl = document.getElementById('ta-sheet-empty');
		const sheetContainerEl = document.getElementById('ta-sheet-container');

		function readSheet() {
			try {
				const parsed = JSON.parse(localStorage.getItem(SHEET_KEY) || '[]');
				return Array.isArray(parsed) ? parsed.filter((entry) => entry && typeof entry === 'object') : [];
			} catch {
				return [];
			}
		}

		function writeSheet(entries) {
			try {
				localStorage.setItem(SHEET_KEY, JSON.stringify(entries));
			} catch {
				/* storage unavailable (private mode) — keep the in-page list only */
			}
		}

		const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

		function dateLabel(iso) {
			if (!iso || typeof iso !== 'string') return '—';
			const [year, month, day] = iso.slice(0, 10).split('-').map(Number);
			if (!year || !month || !day) return iso;
			return `${String(day).padStart(2, '0')} ${MONTHS[month - 1]} ${year}`;
		}

		function timeLabel(value) {
			if (!value || typeof value !== 'string' || value.length < 16) return '—';
			return value.slice(11, 16);
		}

		function buildTrip() {
			const time = dutyHours();
			if (!time || time.error) return null;

			const rate = Number(rateInput && rateInput.value) || 0;
			const hours = time.hours;
			const blocks = slabBreakdown(hours);
			const totalPct = blocks.reduce((sum, value) => sum + value, 0);
			const amount = Math.round((rate * totalPct) / 100);

			const hqInput = document.getElementById('ta-hq');
			const dutyInput = document.getElementById('ta-duty');
			const hqCode = hqField.code || (hqInput ? hqInput.value.trim().toUpperCase() : '');
			const dutyCode = dutyField.code || (dutyInput ? dutyInput.value.trim().toUpperCase() : '');
			const hqName = graph && hqField.code ? stationInfo(graph, hqField.code)?.name || '' : '';
			const dutyName = graph && dutyField.code ? stationInfo(graph, dutyField.code)?.name || '' : '';

			const depart = departInput ? departInput.value : '';
			const arrive = arriveInput ? arriveInput.value : '';
			const date = depart ? depart.slice(0, 10) : new Date().toISOString().slice(0, 10);
			const id =
				window.crypto && typeof window.crypto.randomUUID === 'function'
					? window.crypto.randomUUID()
					: `trip-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;

			return {
				id,
				date,
				hqCode,
				hqName,
				dutyCode,
				dutyName,
				km: typeof distanceKm === 'number' ? distanceKm : null,
				depart,
				arrive,
				hours,
				slab: blocks.map((value) => `${value}%`).join(' + '),
				amount,
				createdAt: Date.now(),
			};
		}

		function addCurrentTrip(button) {
			const trip = buildTrip();
			if (!trip) return;
			const entries = readSheet();
			entries.push(trip);
			writeSheet(entries);
			renderSheet();
			if (button) {
				const original = button.textContent;
				button.textContent = t('addedBtn');
				button.disabled = true;
				window.setTimeout(() => {
					button.textContent = original;
					button.disabled = false;
				}, 1400);
			}
		}

		function removeTrip(id) {
			if (!id) return;
			const entries = readSheet().filter((trip) => String(trip.id) !== String(id));
			writeSheet(entries);
			renderSheet();
		}

		function renderSheet() {
			if (!sheetBodyEl || !sheetFootEl) return;
			const trips = readSheet()
				.slice()
				.sort((a, b) => (Number(a.createdAt) || 0) - (Number(b.createdAt) || 0));

			if (trips.length === 0) {
				sheetBodyEl.innerHTML = '';
				sheetFootEl.innerHTML = '';
				if (sheetContainerEl) sheetContainerEl.classList.add('hidden');
				if (sheetEmptyEl) sheetEmptyEl.classList.remove('hidden');
				return;
			}

			if (sheetContainerEl) sheetContainerEl.classList.remove('hidden');
			if (sheetEmptyEl) sheetEmptyEl.classList.add('hidden');

			sheetBodyEl.innerHTML = trips
				.map((trip) => {
					const hq = trip.hqCode || trip.hqName || '—';
					const duty = trip.dutyCode || trip.dutyName || '—';
					const km = typeof trip.km === 'number' ? trip.km.toLocaleString('en-IN') : '—';
					const names = [trip.hqName, trip.dutyName].filter(Boolean).join(' → ');
					const amount = Number(trip.amount) || 0;
					const hours = Number(trip.hours) || 0;
					return `<tr class="border-b border-line/60 align-top">
						<td class="data-mono whitespace-nowrap px-2 py-2.5 text-body-sm text-foreground">${esc(dateLabel(trip.date))}</td>
						<td class="min-w-0 break-words px-2 py-2.5 text-body-sm text-foreground">
							<span class="data-mono font-semibold">${esc(hq)}</span> <span class="text-muted" aria-hidden="true">→</span> <span class="data-mono font-semibold">${esc(duty)}</span>
							${names ? `<span class="mt-0.5 block break-words text-body-sm text-muted">${esc(names)}</span>` : ''}
						</td>
						<td class="data-mono whitespace-nowrap px-2 py-2.5 text-right tabular-nums text-foreground">${km}</td>
						<td class="data-mono whitespace-nowrap px-2 py-2.5 text-muted" title="${esc(trip.depart || '')}">${esc(timeLabel(trip.depart))}</td>
						<td class="data-mono whitespace-nowrap px-2 py-2.5 text-muted" title="${esc(trip.arrive || '')}">${esc(timeLabel(trip.arrive))}</td>
						<td class="data-mono whitespace-nowrap px-2 py-2.5 text-right tabular-nums text-foreground">${hours.toFixed(1)} h</td>
						<td class="data-mono whitespace-nowrap px-2 py-2.5 text-right tabular-nums text-foreground">${esc(trip.slab || '—')}</td>
						<td class="data-mono whitespace-nowrap px-2 py-2.5 text-right tabular-nums font-semibold text-foreground">₹${amount.toLocaleString('en-IN')}</td>
						<td data-print="hide" class="px-2 py-2.5 text-right">
							<button type="button" data-remove-trip="${esc(trip.id)}" aria-label="Remove trip" title="Remove trip" class="focus-ring inline-flex h-7 w-7 items-center justify-center rounded-sm text-muted transition-colors hover:text-foreground">×</button>
						</td>
					</tr>`;
				})
				.join('');

			const total = trips.reduce((sum, trip) => sum + (Number(trip.amount) || 0), 0);
			sheetFootEl.innerHTML = `<div class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-line bg-background/40 px-3 py-3">
				<span class="data-mono text-body-sm text-muted">${t('footTotalTrips')}: <span class="font-semibold text-foreground">${trips.length}</span></span>
				<span class="inline-flex max-w-full flex-wrap items-center gap-2 rounded-full border border-emerald-600/30 bg-emerald-500/10 px-3 py-1.5 dark:border-emerald-500/30">
					<span class="data-mono text-eyebrow uppercase text-emerald-700 dark:text-emerald-400">${t('footGrandTotal')}</span>
					<span class="data-mono text-body-md font-semibold tabular-nums text-emerald-700 dark:text-emerald-400">₹${total.toLocaleString('en-IN')}</span>
				</span>
			</div>`;
		}

		function monthlyText() {
			const trips = readSheet();
			const header = [t('sheetTextTitle'), `${t('sheetTextTotalTrips')}: ${trips.length}`, ''];
			if (!trips.length) return [...header, t('sheetTextNoTrips')].join('\n');
			const lines = trips.map((trip, index) => {
				const km = typeof trip.km === 'number' ? `${trip.km.toLocaleString('en-IN')} km` : '—';
				const amount = Number(trip.amount) || 0;
				const hours = Number(trip.hours) || 0;
				return `${index + 1}) ${dateLabel(trip.date)} · ${trip.hqCode || '—'} → ${trip.dutyCode || '—'} · ${km} · ${timeLabel(trip.depart)}–${timeLabel(trip.arrive)} · ${hours.toFixed(1)} h · ${trip.slab || '—'} · ₹${amount.toLocaleString('en-IN')}`;
			});
			const total = trips.reduce((sum, trip) => sum + (Number(trip.amount) || 0), 0);
			return [...header, ...lines, '', `${t('sheetTextGrandTotal')}: ₹${total.toLocaleString('en-IN')}`].join('\n');
		}

		async function copyText(text) {
			try {
				if (navigator.clipboard && window.isSecureContext) {
					await navigator.clipboard.writeText(text);
					return true;
				}
			} catch {
				/* fall through to legacy copy */
			}
			try {
				const area = document.createElement('textarea');
				area.value = text;
				area.setAttribute('readonly', '');
				area.style.position = 'fixed';
				area.style.opacity = '0';
				document.body.appendChild(area);
				area.select();
				const ok = document.execCommand('copy');
				document.body.removeChild(area);
				return ok;
			} catch {
				return false;
			}
		}

		function clearSheet() {
			const trips = readSheet();
			if (!trips.length) return;
			if (!window.confirm(t('clearConfirm', { n: trips.length }))) return;
			writeSheet([]);
			renderSheet();
		}

		if (resultEl) {
			resultEl.addEventListener('click', (event) => {
				const button = event.target.closest('[data-add-trip]');
				if (button) addCurrentTrip(button);
			});
		}
		if (sheetBodyEl) {
			sheetBodyEl.addEventListener('click', (event) => {
				const button = event.target.closest('[data-remove-trip]');
				if (button) removeTrip(button.dataset.removeTrip);
			});
		}

		const whatsappBtn = document.getElementById('ta-whatsapp');
		const copySummaryBtn = document.getElementById('ta-copy');
		const printSheetBtn = document.getElementById('ta-print');
		const clearSheetBtn = document.getElementById('ta-clear');

		if (whatsappBtn) {
			whatsappBtn.addEventListener('click', () => {
				const text = monthlyText();
				window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank', 'noopener,noreferrer');
			});
		}
		if (copySummaryBtn) {
			copySummaryBtn.addEventListener('click', async () => {
				const ok = await copyText(monthlyText());
				copySummaryBtn.textContent = ok ? t('copyDone') : t('copyFailed');
				window.setTimeout(() => {
					copySummaryBtn.textContent = t('copyBtn');
				}, 1500);
			});
		}
		if (printSheetBtn) {
			printSheetBtn.addEventListener('click', () => window.print());
		}
		if (clearSheetBtn) {
			clearSheetBtn.addEventListener('click', clearSheet);
		}

		/* --------------------------------------------------------------- Setup */

		function applyPreset() {
			const preset = LEVEL_PRESETS[levelSelect && levelSelect.value] || LEVEL_PRESETS['1-5'];
			const value = daSelect && daSelect.value === 'da' ? preset.da : preset.standard;
			if (rateInput) rateInput.value = String(value);
			render();
		}

		if (levelSelect) levelSelect.addEventListener('change', applyPreset);
		if (daSelect) daSelect.addEventListener('change', applyPreset);
		if (rateInput) rateInput.addEventListener('input', render);
		if (departInput) departInput.addEventListener('input', render);
		if (arriveInput) arriveInput.addEventListener('input', render);

		async function boot() {
			applyPreset();
			renderSheet();
			try {
				const response = await fetch('/api/railway-graph.json');
				if (!response.ok) throw new Error(`Graph request failed (${response.status})`);
				graph = await response.json();
			} catch {
				if (distanceResultEl) {
					distanceResultEl.innerHTML = `<div class="rounded-md border border-error/40 bg-error/5 p-4" role="alert">
						<p class="data-mono text-eyebrow uppercase text-error">${t('errStationIndex')}</p>
						<p class="mt-1 text-body-sm text-muted">${t('errStationIndexBody')}</p>
					</div>`;
				}
				return;
			}
			computeDistance();
		}

		window.addEventListener('railkm:langchange', () => {
			computeDistance();
			renderSheet();
		});

		boot();
	</script>
	<BackToTop />
</Layout>
